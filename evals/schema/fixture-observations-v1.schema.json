{
  "$defs": {
    "EvaluationDecisionTrace": {
      "additionalProperties": false,
      "properties": {
        "retrievals": {
          "items": {
            "$ref": "#/$defs/ObservedRetrieval"
          },
          "title": "Retrievals",
          "type": "array"
        },
        "retrieval_plan_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Plan Version"
        },
        "retrieval_rounds": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObservedRetrievalRoundTrace"
          },
          "title": "Retrieval Rounds",
          "type": "array"
        },
        "assessments": {
          "items": {
            "$ref": "#/$defs/ObservedEvidenceAssessment"
          },
          "title": "Assessments",
          "type": "array"
        },
        "citation_validations": {
          "items": {
            "$ref": "#/$defs/ObservedCitationValidation"
          },
          "title": "Citation Validations",
          "type": "array"
        },
        "supplemental_retrieval_attempts": {
          "maximum": 1,
          "minimum": 0,
          "title": "Supplemental Retrieval Attempts",
          "type": "integer"
        },
        "citation_repair_attempts": {
          "maximum": 1,
          "minimum": 0,
          "title": "Citation Repair Attempts",
          "type": "integer"
        }
      },
      "required": [
        "retrievals",
        "assessments",
        "citation_validations",
        "supplemental_retrieval_attempts",
        "citation_repair_attempts"
      ],
      "title": "EvaluationDecisionTrace",
      "type": "object"
    },
    "FixtureObservation": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "answered",
            "refused",
            "error"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Answer"
        },
        "retrieved_evidence": {
          "items": {
            "$ref": "#/$defs/ObservedEvidence"
          },
          "title": "Retrieved Evidence",
          "type": "array"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/ObservedEvidence"
          },
          "title": "Citations",
          "type": "array"
        },
        "decision_trace": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvaluationDecisionTrace"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "answer",
        "retrieved_evidence",
        "citations",
        "case_id"
      ],
      "title": "FixtureObservation",
      "type": "object"
    },
    "ObservedCitationValidation": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "anyOf": [
            {
              "enum": [
                "initial",
                "repair"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "issue": {
          "enum": [
            "empty_answer",
            "uncited_claim",
            "unknown_label",
            "valid"
          ],
          "title": "Issue",
          "type": "string"
        },
        "unit_count": {
          "default": 0,
          "minimum": 0,
          "title": "Unit Count",
          "type": "integer"
        },
        "citation_count": {
          "default": 0,
          "minimum": 0,
          "title": "Citation Count",
          "type": "integer"
        },
        "uncited_unit_indices": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Uncited Unit Indices",
          "type": "array"
        },
        "unknown_label_unit_indices": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Unknown Label Unit Indices",
          "type": "array"
        }
      },
      "required": [
        "valid",
        "issue"
      ],
      "title": "ObservedCitationValidation",
      "type": "object"
    },
    "ObservedEvidence": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        },
        "document_version_id": {
          "format": "uuid",
          "title": "Document Version Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "document_version_id",
        "page_number",
        "text"
      ],
      "title": "ObservedEvidence",
      "type": "object"
    },
    "ObservedEvidenceAssessment": {
      "additionalProperties": false,
      "properties": {
        "sufficient": {
          "title": "Sufficient",
          "type": "boolean"
        },
        "selected_chunk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Selected Chunk Ids",
          "type": "array"
        },
        "supplemental_queries": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "title": "Supplemental Queries",
          "type": "array"
        }
      },
      "required": [
        "sufficient",
        "selected_chunk_ids",
        "supplemental_queries"
      ],
      "title": "ObservedEvidenceAssessment",
      "type": "object"
    },
    "ObservedFusedCandidateTrace": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "format": "uuid",
          "title": "Chunk Id",
          "type": "string"
        },
        "fused_score": {
          "exclusiveMinimum": 0,
          "title": "Fused Score",
          "type": "number"
        },
        "best_raw_cosine_score": {
          "maximum": 1,
          "minimum": -1,
          "title": "Best Raw Cosine Score",
          "type": "number"
        },
        "reranker_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reranker Score"
        },
        "reranked_rank": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reranked Rank"
        },
        "selected_as_primary": {
          "title": "Selected As Primary",
          "type": "boolean"
        }
      },
      "required": [
        "chunk_id",
        "fused_score",
        "best_raw_cosine_score",
        "selected_as_primary"
      ],
      "title": "ObservedFusedCandidateTrace",
      "type": "object"
    },
    "ObservedQueryCandidateTrace": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "format": "uuid",
          "title": "Chunk Id",
          "type": "string"
        },
        "raw_rank": {
          "exclusiveMinimum": 0,
          "title": "Raw Rank",
          "type": "integer"
        },
        "raw_cosine_score": {
          "maximum": 1,
          "minimum": -1,
          "title": "Raw Cosine Score",
          "type": "number"
        },
        "reranker_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reranker Score"
        },
        "reranked_rank": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reranked Rank"
        },
        "selected_for_query_coverage": {
          "default": false,
          "title": "Selected For Query Coverage",
          "type": "boolean"
        }
      },
      "required": [
        "chunk_id",
        "raw_rank",
        "raw_cosine_score"
      ],
      "title": "ObservedQueryCandidateTrace",
      "type": "object"
    },
    "ObservedQueryRetrievalTrace": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/ObservedQueryCandidateTrace"
          },
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "query",
        "candidates"
      ],
      "title": "ObservedQueryRetrievalTrace",
      "type": "object"
    },
    "ObservedRerankerTrace": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "config_version": {
          "minLength": 1,
          "title": "Config Version",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "revision",
        "config_version"
      ],
      "title": "ObservedRerankerTrace",
      "type": "object"
    },
    "ObservedRetrieval": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/ObservedRetrievalCandidate"
          },
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "query",
        "candidates"
      ],
      "title": "ObservedRetrieval",
      "type": "object"
    },
    "ObservedRetrievalCandidate": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "format": "uuid",
          "title": "Chunk Id",
          "type": "string"
        },
        "document_version_id": {
          "format": "uuid",
          "title": "Document Version Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "score": {
          "maximum": 1,
          "minimum": -1,
          "title": "Score",
          "type": "number"
        },
        "raw_rank": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Rank"
        }
      },
      "required": [
        "chunk_id",
        "document_version_id",
        "page_number",
        "score"
      ],
      "title": "ObservedRetrievalCandidate",
      "type": "object"
    },
    "ObservedRetrievalRoundTrace": {
      "additionalProperties": false,
      "properties": {
        "round_number": {
          "exclusiveMinimum": 0,
          "maximum": 2,
          "title": "Round Number",
          "type": "integer"
        },
        "queries": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Queries",
          "type": "array"
        },
        "query_results": {
          "items": {
            "$ref": "#/$defs/ObservedQueryRetrievalTrace"
          },
          "title": "Query Results",
          "type": "array"
        },
        "fused_candidates": {
          "items": {
            "$ref": "#/$defs/ObservedFusedCandidateTrace"
          },
          "title": "Fused Candidates",
          "type": "array"
        },
        "final_evidence_chunk_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Final Evidence Chunk Ids",
          "type": "array"
        },
        "rrf_rank_constant": {
          "exclusiveMinimum": 0,
          "title": "Rrf Rank Constant",
          "type": "integer"
        },
        "reranker": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservedRerankerTrace"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "round_number",
        "queries",
        "query_results",
        "fused_candidates",
        "final_evidence_chunk_ids",
        "rrf_rank_constant"
      ],
      "title": "ObservedRetrievalRoundTrace",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/FixtureObservation"
      },
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version",
    "observations"
  ],
  "title": "FixtureObservationSet",
  "type": "object"
}
