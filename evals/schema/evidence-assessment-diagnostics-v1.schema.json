{
  "$defs": {
    "EvaluationRunMetadata": {
      "additionalProperties": false,
      "properties": {
        "code_commit": {
          "minLength": 1,
          "title": "Code Commit",
          "type": "string"
        },
        "model_provider": {
          "minLength": 1,
          "title": "Model Provider",
          "type": "string"
        },
        "model_name": {
          "minLength": 1,
          "title": "Model Name",
          "type": "string"
        },
        "workflow_version": {
          "minLength": 1,
          "title": "Workflow Version",
          "type": "string"
        },
        "parser_version": {
          "minLength": 1,
          "title": "Parser Version",
          "type": "string"
        },
        "tokenizer": {
          "minLength": 1,
          "title": "Tokenizer",
          "type": "string"
        },
        "chunk_size": {
          "exclusiveMinimum": 0,
          "title": "Chunk Size",
          "type": "integer"
        },
        "chunk_overlap": {
          "minimum": 0,
          "title": "Chunk Overlap",
          "type": "integer"
        },
        "chunking_version": {
          "minLength": 1,
          "title": "Chunking Version",
          "type": "string"
        },
        "embedding_provider": {
          "minLength": 1,
          "title": "Embedding Provider",
          "type": "string"
        },
        "embedding_model": {
          "minLength": 1,
          "title": "Embedding Model",
          "type": "string"
        },
        "embedding_revision": {
          "minLength": 1,
          "title": "Embedding Revision",
          "type": "string"
        },
        "embedding_dimension": {
          "exclusiveMinimum": 0,
          "title": "Embedding Dimension",
          "type": "integer"
        },
        "embedding_version": {
          "minLength": 1,
          "title": "Embedding Version",
          "type": "string"
        },
        "retrieval_version": {
          "minLength": 1,
          "title": "Retrieval Version",
          "type": "string"
        },
        "retrieval_top_k": {
          "exclusiveMinimum": 0,
          "title": "Retrieval Top K",
          "type": "integer"
        },
        "retrieval_page_neighbor_count": {
          "default": 0,
          "minimum": 0,
          "title": "Retrieval Page Neighbor Count",
          "type": "integer"
        },
        "retrieval_rrf_rank_constant": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Rrf Rank Constant"
        },
        "retrieval_minimum_score": {
          "maximum": 1,
          "minimum": -1,
          "title": "Retrieval Minimum Score",
          "type": "number"
        },
        "retrieval_minimum_evidence": {
          "exclusiveMinimum": 0,
          "title": "Retrieval Minimum Evidence",
          "type": "integer"
        },
        "generation_prompt_version": {
          "minLength": 1,
          "title": "Generation Prompt Version",
          "type": "string"
        },
        "question_rewrite_prompt_version": {
          "minLength": 1,
          "title": "Question Rewrite Prompt Version",
          "type": "string"
        },
        "evidence_assessment_prompt_version": {
          "minLength": 1,
          "title": "Evidence Assessment Prompt Version",
          "type": "string"
        },
        "citation_repair_prompt_version": {
          "minLength": 1,
          "title": "Citation Repair Prompt Version",
          "type": "string"
        },
        "provider_connect_timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Connect Timeout Seconds"
        },
        "provider_read_timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Read Timeout Seconds"
        },
        "provider_request_timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Request Timeout Seconds"
        },
        "provider_operation_deadline_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Operation Deadline Seconds"
        }
      },
      "required": [
        "code_commit",
        "model_provider",
        "model_name",
        "workflow_version",
        "parser_version",
        "tokenizer",
        "chunk_size",
        "chunk_overlap",
        "chunking_version",
        "embedding_provider",
        "embedding_model",
        "embedding_revision",
        "embedding_dimension",
        "embedding_version",
        "retrieval_version",
        "retrieval_top_k",
        "retrieval_minimum_score",
        "retrieval_minimum_evidence",
        "generation_prompt_version",
        "question_rewrite_prompt_version",
        "evidence_assessment_prompt_version",
        "citation_repair_prompt_version"
      ],
      "title": "EvaluationRunMetadata",
      "type": "object"
    },
    "EvidenceAssessmentCaseDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "primary_mechanism": {
          "$ref": "#/$defs/EvidenceAssessmentFailureMechanism"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/EvidenceAssessmentClaimDiagnostic"
          },
          "title": "Claims",
          "type": "array"
        },
        "retrieval_plan_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retrieval Plan Version"
        },
        "candidate_sources": {
          "items": {
            "$ref": "#/$defs/SanitizedEvidenceChunk"
          },
          "title": "Candidate Sources",
          "type": "array"
        },
        "retrieval_rounds": {
          "items": {
            "$ref": "#/$defs/EvidenceAssessmentRetrievalRoundDiagnostic"
          },
          "maxItems": 2,
          "title": "Retrieval Rounds",
          "type": "array"
        },
        "assessment_rounds": {
          "items": {
            "$ref": "#/$defs/EvidenceAssessmentRoundDiagnostic"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Assessment Rounds",
          "type": "array"
        },
        "supplemental_retrieval_attempts": {
          "maximum": 1,
          "minimum": 0,
          "title": "Supplemental Retrieval Attempts",
          "type": "integer"
        }
      },
      "required": [
        "case_id",
        "primary_mechanism",
        "claims",
        "retrieval_plan_version",
        "candidate_sources",
        "retrieval_rounds",
        "assessment_rounds",
        "supplemental_retrieval_attempts"
      ],
      "title": "EvidenceAssessmentCaseDiagnostic",
      "type": "object"
    },
    "EvidenceAssessmentClaimDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/SanitizedEvidenceLocation"
        },
        "retrieval_match_status": {
          "$ref": "#/$defs/EvidenceMatchStatus"
        },
        "selected_source_page": {
          "title": "Selected Source Page",
          "type": "boolean"
        }
      },
      "required": [
        "claim_id",
        "expected",
        "retrieval_match_status",
        "selected_source_page"
      ],
      "title": "EvidenceAssessmentClaimDiagnostic",
      "type": "object"
    },
    "EvidenceAssessmentDiagnosticsSummary": {
      "additionalProperties": false,
      "properties": {
        "failed_answerable_refusals": {
          "minimum": 0,
          "title": "Failed Answerable Refusals",
          "type": "integer"
        },
        "no_evidence_selected": {
          "minimum": 0,
          "title": "No Evidence Selected",
          "type": "integer"
        },
        "expected_source_pages_not_selected": {
          "minimum": 0,
          "title": "Expected Source Pages Not Selected",
          "type": "integer"
        },
        "expected_source_pages_selected_but_insufficient": {
          "minimum": 0,
          "title": "Expected Source Pages Selected But Insufficient",
          "type": "integer"
        }
      },
      "required": [
        "failed_answerable_refusals",
        "no_evidence_selected",
        "expected_source_pages_not_selected",
        "expected_source_pages_selected_but_insufficient"
      ],
      "title": "EvidenceAssessmentDiagnosticsSummary",
      "type": "object"
    },
    "EvidenceAssessmentFailureMechanism": {
      "enum": [
        "no_evidence_selected",
        "expected_source_pages_not_selected",
        "expected_source_pages_selected_but_insufficient"
      ],
      "type": "string"
    },
    "EvidenceAssessmentRetrievalRoundDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "round_number": {
          "exclusiveMinimum": 0,
          "maximum": 2,
          "title": "Round Number",
          "type": "integer"
        },
        "queries": {
          "items": {
            "$ref": "#/$defs/SanitizedRetrievalQueryDiagnostic"
          },
          "title": "Queries",
          "type": "array"
        },
        "final_evidence_chunk_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Final Evidence Chunk Ids",
          "type": "array"
        }
      },
      "required": [
        "round_number",
        "queries",
        "final_evidence_chunk_ids"
      ],
      "title": "EvidenceAssessmentRetrievalRoundDiagnostic",
      "type": "object"
    },
    "EvidenceAssessmentRoundDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "round_number": {
          "exclusiveMinimum": 0,
          "maximum": 2,
          "title": "Round Number",
          "type": "integer"
        },
        "sufficient": {
          "title": "Sufficient",
          "type": "boolean"
        },
        "selected_chunk_count": {
          "minimum": 0,
          "title": "Selected Chunk Count",
          "type": "integer"
        },
        "selected_chunks": {
          "items": {
            "$ref": "#/$defs/SanitizedEvidenceChunk"
          },
          "title": "Selected Chunks",
          "type": "array"
        },
        "preserved_selection_chunk_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Preserved Selection Chunk Ids",
          "type": "array"
        },
        "selected_source_pages": {
          "items": {
            "$ref": "#/$defs/SanitizedEvidenceLocation"
          },
          "title": "Selected Source Pages",
          "type": "array"
        },
        "supplemental_query_count": {
          "maximum": 2,
          "minimum": 0,
          "title": "Supplemental Query Count",
          "type": "integer"
        },
        "supplemental_query_sha256": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "title": "Supplemental Query Sha256",
          "type": "array"
        }
      },
      "required": [
        "round_number",
        "sufficient",
        "selected_chunk_count",
        "selected_chunks",
        "preserved_selection_chunk_ids",
        "selected_source_pages",
        "supplemental_query_count",
        "supplemental_query_sha256"
      ],
      "title": "EvidenceAssessmentRoundDiagnostic",
      "type": "object"
    },
    "EvidenceMatchStatus": {
      "enum": [
        "canonical",
        "approved_alternative",
        "not_matched"
      ],
      "type": "string"
    },
    "SanitizedEvidenceChunk": {
      "additionalProperties": false,
      "properties": {
        "document_version_id": {
          "format": "uuid",
          "title": "Document Version Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "chunk_id": {
          "format": "uuid",
          "title": "Chunk Id",
          "type": "string"
        }
      },
      "required": [
        "document_version_id",
        "page_number",
        "chunk_id"
      ],
      "title": "SanitizedEvidenceChunk",
      "type": "object"
    },
    "SanitizedEvidenceLocation": {
      "additionalProperties": false,
      "properties": {
        "document_version_id": {
          "format": "uuid",
          "title": "Document Version Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        }
      },
      "required": [
        "document_version_id",
        "page_number"
      ],
      "title": "SanitizedEvidenceLocation",
      "type": "object"
    },
    "SanitizedRetrievalQueryDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "query_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Query Sha256",
          "type": "string"
        },
        "candidate_chunk_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Candidate Chunk Ids",
          "type": "array"
        },
        "query_coverage_chunk_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Query Coverage Chunk Ids",
          "type": "array"
        }
      },
      "required": [
        "query_sha256",
        "candidate_chunk_ids",
        "query_coverage_chunk_ids"
      ],
      "title": "SanitizedRetrievalQueryDiagnostic",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
    },
    "report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Sha256",
      "type": "string"
    },
    "source_metadata": {
      "$ref": "#/$defs/EvaluationRunMetadata"
    },
    "summary": {
      "$ref": "#/$defs/EvidenceAssessmentDiagnosticsSummary"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/EvidenceAssessmentCaseDiagnostic"
      },
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "report_sha256",
    "source_metadata",
    "summary",
    "cases"
  ],
  "title": "EvidenceAssessmentDiagnosticsReport",
  "type": "object"
}
