{
  "$defs": {
    "CitationCaseDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "primary_mechanism": {
          "$ref": "#/$defs/CitationFailureMechanism"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/CitationClaimDiagnostic"
          },
          "title": "Claims",
          "type": "array"
        },
        "cited_passages": {
          "items": {
            "$ref": "#/$defs/SanitizedEvidenceLocation"
          },
          "title": "Cited Passages",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "primary_mechanism",
        "claims",
        "cited_passages"
      ],
      "title": "CitationCaseDiagnostic",
      "type": "object"
    },
    "CitationClaimDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/SanitizedEvidenceLocation"
        },
        "retrieval_status": {
          "$ref": "#/$defs/CitationObservationStatus"
        },
        "citation_status": {
          "$ref": "#/$defs/CitationObservationStatus"
        }
      },
      "required": [
        "claim_id",
        "expected",
        "retrieval_status",
        "citation_status"
      ],
      "title": "CitationClaimDiagnostic",
      "type": "object"
    },
    "CitationDiagnosticsSummary": {
      "additionalProperties": false,
      "properties": {
        "failed_answered_cases": {
          "minimum": 0,
          "title": "Failed Answered Cases",
          "type": "integer"
        },
        "expected_evidence_not_retrieved": {
          "minimum": 0,
          "title": "Expected Evidence Not Retrieved",
          "type": "integer"
        },
        "retrieved_but_not_cited": {
          "minimum": 0,
          "title": "Retrieved But Not Cited",
          "type": "integer"
        },
        "same_page_different_chunk": {
          "minimum": 0,
          "title": "Same Page Different Chunk",
          "type": "integer"
        },
        "partial_claim_coverage": {
          "minimum": 0,
          "title": "Partial Claim Coverage",
          "type": "integer"
        }
      },
      "required": [
        "failed_answered_cases",
        "expected_evidence_not_retrieved",
        "retrieved_but_not_cited",
        "same_page_different_chunk",
        "partial_claim_coverage"
      ],
      "title": "CitationDiagnosticsSummary",
      "type": "object"
    },
    "CitationFailureMechanism": {
      "enum": [
        "expected_evidence_not_retrieved",
        "retrieved_but_not_cited",
        "same_page_different_chunk",
        "partial_claim_coverage"
      ],
      "type": "string"
    },
    "CitationObservationStatus": {
      "enum": [
        "canonical",
        "approved_alternative",
        "same_page_different_chunk",
        "not_observed"
      ],
      "type": "string"
    },
    "EvaluationRunMetadata": {
      "additionalProperties": false,
      "properties": {
        "code_commit": {
          "minLength": 1,
          "title": "Code Commit",
          "type": "string"
        },
        "model_provider": {
          "minLength": 1,
          "title": "Model Provider",
          "type": "string"
        },
        "model_name": {
          "minLength": 1,
          "title": "Model Name",
          "type": "string"
        },
        "workflow_version": {
          "minLength": 1,
          "title": "Workflow Version",
          "type": "string"
        },
        "parser_version": {
          "minLength": 1,
          "title": "Parser Version",
          "type": "string"
        },
        "tokenizer": {
          "minLength": 1,
          "title": "Tokenizer",
          "type": "string"
        },
        "chunk_size": {
          "exclusiveMinimum": 0,
          "title": "Chunk Size",
          "type": "integer"
        },
        "chunk_overlap": {
          "minimum": 0,
          "title": "Chunk Overlap",
          "type": "integer"
        },
        "chunking_version": {
          "minLength": 1,
          "title": "Chunking Version",
          "type": "string"
        },
        "embedding_provider": {
          "minLength": 1,
          "title": "Embedding Provider",
          "type": "string"
        },
        "embedding_model": {
          "minLength": 1,
          "title": "Embedding Model",
          "type": "string"
        },
        "embedding_revision": {
          "minLength": 1,
          "title": "Embedding Revision",
          "type": "string"
        },
        "embedding_dimension": {
          "exclusiveMinimum": 0,
          "title": "Embedding Dimension",
          "type": "integer"
        },
        "embedding_version": {
          "minLength": 1,
          "title": "Embedding Version",
          "type": "string"
        },
        "retrieval_version": {
          "minLength": 1,
          "title": "Retrieval Version",
          "type": "string"
        },
        "retrieval_top_k": {
          "exclusiveMinimum": 0,
          "title": "Retrieval Top K",
          "type": "integer"
        },
        "retrieval_page_neighbor_count": {
          "default": 0,
          "minimum": 0,
          "title": "Retrieval Page Neighbor Count",
          "type": "integer"
        },
        "retrieval_rrf_rank_constant": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Rrf Rank Constant"
        },
        "retrieval_minimum_score": {
          "maximum": 1,
          "minimum": -1,
          "title": "Retrieval Minimum Score",
          "type": "number"
        },
        "retrieval_minimum_evidence": {
          "exclusiveMinimum": 0,
          "title": "Retrieval Minimum Evidence",
          "type": "integer"
        },
        "generation_prompt_version": {
          "minLength": 1,
          "title": "Generation Prompt Version",
          "type": "string"
        },
        "question_rewrite_prompt_version": {
          "minLength": 1,
          "title": "Question Rewrite Prompt Version",
          "type": "string"
        },
        "evidence_assessment_prompt_version": {
          "minLength": 1,
          "title": "Evidence Assessment Prompt Version",
          "type": "string"
        },
        "citation_repair_prompt_version": {
          "minLength": 1,
          "title": "Citation Repair Prompt Version",
          "type": "string"
        }
      },
      "required": [
        "code_commit",
        "model_provider",
        "model_name",
        "workflow_version",
        "parser_version",
        "tokenizer",
        "chunk_size",
        "chunk_overlap",
        "chunking_version",
        "embedding_provider",
        "embedding_model",
        "embedding_revision",
        "embedding_dimension",
        "embedding_version",
        "retrieval_version",
        "retrieval_top_k",
        "retrieval_minimum_score",
        "retrieval_minimum_evidence",
        "generation_prompt_version",
        "question_rewrite_prompt_version",
        "evidence_assessment_prompt_version",
        "citation_repair_prompt_version"
      ],
      "title": "EvaluationRunMetadata",
      "type": "object"
    },
    "SanitizedEvidenceLocation": {
      "additionalProperties": false,
      "properties": {
        "document_version_id": {
          "format": "uuid",
          "title": "Document Version Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        }
      },
      "required": [
        "document_version_id",
        "page_number"
      ],
      "title": "SanitizedEvidenceLocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "minLength": 1,
      "title": "Dataset Version",
      "type": "string"
    },
    "report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Sha256",
      "type": "string"
    },
    "source_metadata": {
      "$ref": "#/$defs/EvaluationRunMetadata"
    },
    "summary": {
      "$ref": "#/$defs/CitationDiagnosticsSummary"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/CitationCaseDiagnostic"
      },
      "title": "Cases",
      "type": "array"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "report_sha256",
    "source_metadata",
    "summary",
    "cases"
  ],
  "title": "CitationDiagnosticsReport",
  "type": "object"
}
