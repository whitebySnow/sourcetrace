{
  "$defs": {
    "CaseEvaluationResult": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "retrieval": {
          "$ref": "#/$defs/EvaluationStatus"
        },
        "citation": {
          "$ref": "#/$defs/EvaluationStatus"
        },
        "refusal": {
          "$ref": "#/$defs/EvaluationStatus"
        },
        "end_to_end": {
          "$ref": "#/$defs/EvaluationStatus"
        },
        "retrieval_evidence_matches": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceClaimMatch"
          },
          "title": "Retrieval Evidence Matches",
          "type": "array"
        },
        "citation_evidence_matches": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceClaimMatch"
          },
          "title": "Citation Evidence Matches",
          "type": "array"
        },
        "observation": {
          "$ref": "#/$defs/EvaluationObservation"
        }
      },
      "required": [
        "case_id",
        "retrieval",
        "citation",
        "refusal",
        "end_to_end",
        "observation"
      ],
      "title": "CaseEvaluationResult",
      "type": "object"
    },
    "DatasetReview": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "reviewed",
            "fixture"
          ],
          "title": "Status",
          "type": "string"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        }
      },
      "required": [
        "status"
      ],
      "title": "DatasetReview",
      "type": "object"
    },
    "EvaluationDecisionTrace": {
      "additionalProperties": false,
      "properties": {
        "retrievals": {
          "items": {
            "$ref": "#/$defs/ObservedRetrieval"
          },
          "title": "Retrievals",
          "type": "array"
        },
        "retrieval_plan_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Plan Version"
        },
        "planning": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservedPlanningTrace"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "retrieval_rounds": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ObservedRetrievalRoundTrace"
          },
          "title": "Retrieval Rounds",
          "type": "array"
        },
        "assessments": {
          "items": {
            "$ref": "#/$defs/ObservedEvidenceAssessment"
          },
          "title": "Assessments",
          "type": "array"
        },
        "citation_validations": {
          "items": {
            "$ref": "#/$defs/ObservedCitationValidation"
          },
          "title": "Citation Validations",
          "type": "array"
        },
        "supplemental_retrieval_attempts": {
          "maximum": 1,
          "minimum": 0,
          "title": "Supplemental Retrieval Attempts",
          "type": "integer"
        },
        "citation_repair_attempts": {
          "maximum": 1,
          "minimum": 0,
          "title": "Citation Repair Attempts",
          "type": "integer"
        }
      },
      "required": [
        "retrievals",
        "assessments",
        "citation_validations",
        "supplemental_retrieval_attempts",
        "citation_repair_attempts"
      ],
      "title": "EvaluationDecisionTrace",
      "type": "object"
    },
    "EvaluationObservation": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "answered",
            "refused",
            "error"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Answer"
        },
        "retrieved_evidence": {
          "items": {
            "$ref": "#/$defs/ObservedEvidence"
          },
          "title": "Retrieved Evidence",
          "type": "array"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/ObservedEvidence"
          },
          "title": "Citations",
          "type": "array"
        },
        "decision_trace": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvaluationDecisionTrace"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "outcome",
        "answer",
        "retrieved_evidence",
        "citations"
      ],
      "title": "EvaluationObservation",
      "type": "object"
    },
    "EvaluationRunMetadata": {
      "additionalProperties": false,
      "properties": {
        "code_commit": {
          "minLength": 1,
          "title": "Code Commit",
          "type": "string"
        },
        "model_provider": {
          "minLength": 1,
          "title": "Model Provider",
          "type": "string"
        },
        "model_name": {
          "minLength": 1,
          "title": "Model Name",
          "type": "string"
        },
        "workflow_version": {
          "minLength": 1,
          "title": "Workflow Version",
          "type": "string"
        },
        "parser_version": {
          "minLength": 1,
          "title": "Parser Version",
          "type": "string"
        },
        "tokenizer": {
          "minLength": 1,
          "title": "Tokenizer",
          "type": "string"
        },
        "chunk_size": {
          "exclusiveMinimum": 0,
          "title": "Chunk Size",
          "type": "integer"
        },
        "chunk_overlap": {
          "minimum": 0,
          "title": "Chunk Overlap",
          "type": "integer"
        },
        "chunking_version": {
          "minLength": 1,
          "title": "Chunking Version",
          "type": "string"
        },
        "embedding_provider": {
          "minLength": 1,
          "title": "Embedding Provider",
          "type": "string"
        },
        "embedding_model": {
          "minLength": 1,
          "title": "Embedding Model",
          "type": "string"
        },
        "embedding_revision": {
          "minLength": 1,
          "title": "Embedding Revision",
          "type": "string"
        },
        "embedding_dimension": {
          "exclusiveMinimum": 0,
          "title": "Embedding Dimension",
          "type": "integer"
        },
        "embedding_version": {
          "minLength": 1,
          "title": "Embedding Version",
          "type": "string"
        },
        "retrieval_version": {
          "minLength": 1,
          "title": "Retrieval Version",
          "type": "string"
        },
        "retrieval_top_k": {
          "exclusiveMinimum": 0,
          "title": "Retrieval Top K",
          "type": "integer"
        },
        "retrieval_page_neighbor_count": {
          "default": 0,
          "minimum": 0,
          "title": "Retrieval Page Neighbor Count",
          "type": "integer"
        },
        "retrieval_rrf_rank_constant": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieval Rrf Rank Constant"
        },
        "retrieval_minimum_score": {
          "maximum": 1,
          "minimum": -1,
          "title": "Retrieval Minimum Score",
          "type": "number"
        },
        "retrieval_minimum_evidence": {
          "exclusiveMinimum": 0,
          "title": "Retrieval Minimum Evidence",
          "type": "integer"
        },
        "generation_prompt_version": {
          "minLength": 1,
          "title": "Generation Prompt Version",
          "type": "string"
        },
        "question_rewrite_prompt_version": {
          "minLength": 1,
          "title": "Question Rewrite Prompt Version",
          "type": "string"
        },
        "evidence_assessment_prompt_version": {
          "minLength": 1,
          "title": "Evidence Assessment Prompt Version",
          "type": "string"
        },
        "citation_repair_prompt_version": {
          "minLength": 1,
          "title": "Citation Repair Prompt Version",
          "type": "string"
        },
        "provider_connect_timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Connect Timeout Seconds"
        },
        "provider_read_timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Read Timeout Seconds"
        },
        "provider_request_timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Request Timeout Seconds"
        },
        "provider_operation_deadline_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Operation Deadline Seconds"
        }
      },
      "required": [
        "code_commit",
        "model_provider",
        "model_name",
        "workflow_version",
        "parser_version",
        "tokenizer",
        "chunk_size",
        "chunk_overlap",
        "chunking_version",
        "embedding_provider",
        "embedding_model",
        "embedding_revision",
        "embedding_dimension",
        "embedding_version",
        "retrieval_version",
        "retrieval_top_k",
        "retrieval_minimum_score",
        "retrieval_minimum_evidence",
        "generation_prompt_version",
        "question_rewrite_prompt_version",
        "evidence_assessment_prompt_version",
        "citation_repair_prompt_version"
      ],
      "title": "EvaluationRunMetadata",
      "type": "object"
    },
    "EvaluationStatus": {
      "enum": [
        "passed",
        "failed",
        "pending_review",
        "not_applicable"
      ],
      "type": "string"
    },
    "EvaluationSummary": {
      "additionalProperties": false,
      "properties": {
        "passed": {
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "pending_review": {
          "minimum": 0,
          "title": "Pending Review",
          "type": "integer"
        },
        "not_applicable": {
          "minimum": 0,
          "title": "Not Applicable",
          "type": "integer"
        }
      },
      "required": [
        "passed",
        "failed",
        "pending_review",
        "not_applicable"
      ],
      "title": "EvaluationSummary",
      "type": "object"
    },
    "EvidenceClaimMatch": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "match_status": {
          "$ref": "#/$defs/EvidenceMatchStatus"
        },
        "matched_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidencePassage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "claim_id",
        "match_status"
      ],
      "title": "EvidenceClaimMatch",
      "type": "object"
    },
    "EvidenceMatchStatus": {
      "enum": [
        "canonical",
        "approved_alternative",
        "not_matched"
      ],
      "type": "string"
    },
    "EvidencePassage": {
      "additionalProperties": false,
      "properties": {
        "document_version_id": {
          "format": "uuid",
          "title": "Document Version Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "document_version_id",
        "page_number",
        "text"
      ],
      "title": "EvidencePassage",
      "type": "object"
    },
    "ObservedCitationValidation": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "anyOf": [
            {
              "enum": [
                "initial",
                "repair"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "issue": {
          "enum": [
            "empty_answer",
            "uncited_claim",
            "unknown_label",
            "valid"
          ],
          "title": "Issue",
          "type": "string"
        },
        "unit_count": {
          "default": 0,
          "minimum": 0,
          "title": "Unit Count",
          "type": "integer"
        },
        "citation_count": {
          "default": 0,
          "minimum": 0,
          "title": "Citation Count",
          "type": "integer"
        },
        "uncited_unit_indices": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Uncited Unit Indices",
          "type": "array"
        },
        "unknown_label_unit_indices": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Unknown Label Unit Indices",
          "type": "array"
        }
      },
      "required": [
        "valid",
        "issue"
      ],
      "title": "ObservedCitationValidation",
      "type": "object"
    },
    "ObservedEvidence": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        },
        "document_version_id": {
          "format": "uuid",
          "title": "Document Version Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "document_version_id",
        "page_number",
        "text"
      ],
      "title": "ObservedEvidence",
      "type": "object"
    },
    "ObservedEvidenceAssessment": {
      "additionalProperties": false,
      "properties": {
        "sufficient": {
          "title": "Sufficient",
          "type": "boolean"
        },
        "selected_chunk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Selected Chunk Ids",
          "type": "array"
        },
        "supplemental_queries": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "title": "Supplemental Queries",
          "type": "array"
        }
      },
      "required": [
        "sufficient",
        "selected_chunk_ids",
        "supplemental_queries"
      ],
      "title": "ObservedEvidenceAssessment",
      "type": "object"
    },
    "ObservedFusedCandidateTrace": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "format": "uuid",
          "title": "Chunk Id",
          "type": "string"
        },
        "fused_score": {
          "exclusiveMinimum": 0,
          "title": "Fused Score",
          "type": "number"
        },
        "best_raw_cosine_score": {
          "maximum": 1,
          "minimum": -1,
          "title": "Best Raw Cosine Score",
          "type": "number"
        },
        "reranker_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reranker Score"
        },
        "reranked_rank": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reranked Rank"
        },
        "selected_as_primary": {
          "title": "Selected As Primary",
          "type": "boolean"
        }
      },
      "required": [
        "chunk_id",
        "fused_score",
        "best_raw_cosine_score",
        "selected_as_primary"
      ],
      "title": "ObservedFusedCandidateTrace",
      "type": "object"
    },
    "ObservedPlanningSlotTrace": {
      "additionalProperties": false,
      "properties": {
        "title_anchor": {
          "maxLength": 255,
          "minLength": 3,
          "title": "Title Anchor",
          "type": "string"
        },
        "refinement_disposition": {
          "enum": [
            "not_required",
            "accepted",
            "provider_error",
            "invalid_shape",
            "document_changed",
            "anchor_changed",
            "anchor_invalid",
            "unchanged_query",
            "title_attribution"
          ],
          "title": "Refinement Disposition",
          "type": "string"
        }
      },
      "required": [
        "title_anchor",
        "refinement_disposition"
      ],
      "title": "ObservedPlanningSlotTrace",
      "type": "object"
    },
    "ObservedPlanningTrace": {
      "additionalProperties": false,
      "properties": {
        "initial_disposition": {
          "enum": [
            "empty",
            "accepted",
            "rejected"
          ],
          "title": "Initial Disposition",
          "type": "string"
        },
        "initial_correction_applied": {
          "title": "Initial Correction Applied",
          "type": "boolean"
        },
        "initial_slot_count": {
          "maximum": 3,
          "minimum": 0,
          "title": "Initial Slot Count",
          "type": "integer"
        },
        "selected_slots": {
          "items": {
            "$ref": "#/$defs/ObservedPlanningSlotTrace"
          },
          "maxItems": 2,
          "title": "Selected Slots",
          "type": "array"
        }
      },
      "required": [
        "initial_disposition",
        "initial_correction_applied",
        "initial_slot_count",
        "selected_slots"
      ],
      "title": "ObservedPlanningTrace",
      "type": "object"
    },
    "ObservedQueryCandidateTrace": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "format": "uuid",
          "title": "Chunk Id",
          "type": "string"
        },
        "raw_rank": {
          "exclusiveMinimum": 0,
          "title": "Raw Rank",
          "type": "integer"
        },
        "raw_cosine_score": {
          "maximum": 1,
          "minimum": -1,
          "title": "Raw Cosine Score",
          "type": "number"
        },
        "reranker_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reranker Score"
        },
        "reranked_rank": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reranked Rank"
        },
        "selected_for_query_coverage": {
          "default": false,
          "title": "Selected For Query Coverage",
          "type": "boolean"
        }
      },
      "required": [
        "chunk_id",
        "raw_rank",
        "raw_cosine_score"
      ],
      "title": "ObservedQueryCandidateTrace",
      "type": "object"
    },
    "ObservedQueryRetrievalTrace": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/ObservedQueryCandidateTrace"
          },
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "query",
        "candidates"
      ],
      "title": "ObservedQueryRetrievalTrace",
      "type": "object"
    },
    "ObservedRerankerTrace": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "config_version": {
          "minLength": 1,
          "title": "Config Version",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "revision",
        "config_version"
      ],
      "title": "ObservedRerankerTrace",
      "type": "object"
    },
    "ObservedRetrieval": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/ObservedRetrievalCandidate"
          },
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "query",
        "candidates"
      ],
      "title": "ObservedRetrieval",
      "type": "object"
    },
    "ObservedRetrievalCandidate": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "format": "uuid",
          "title": "Chunk Id",
          "type": "string"
        },
        "document_version_id": {
          "format": "uuid",
          "title": "Document Version Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "score": {
          "maximum": 1,
          "minimum": -1,
          "title": "Score",
          "type": "number"
        },
        "raw_rank": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Rank"
        }
      },
      "required": [
        "chunk_id",
        "document_version_id",
        "page_number",
        "score"
      ],
      "title": "ObservedRetrievalCandidate",
      "type": "object"
    },
    "ObservedRetrievalRoundTrace": {
      "additionalProperties": false,
      "properties": {
        "round_number": {
          "exclusiveMinimum": 0,
          "maximum": 2,
          "title": "Round Number",
          "type": "integer"
        },
        "queries": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Queries",
          "type": "array"
        },
        "query_results": {
          "items": {
            "$ref": "#/$defs/ObservedQueryRetrievalTrace"
          },
          "title": "Query Results",
          "type": "array"
        },
        "fused_candidates": {
          "items": {
            "$ref": "#/$defs/ObservedFusedCandidateTrace"
