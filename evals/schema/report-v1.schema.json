{
  "$defs": {
    "CaseEvaluationResult": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "retrieval": {
          "$ref": "#/$defs/EvaluationStatus"
        },
        "citation": {
          "$ref": "#/$defs/EvaluationStatus"
        },
        "refusal": {
          "$ref": "#/$defs/EvaluationStatus"
        },
        "end_to_end": {
          "$ref": "#/$defs/EvaluationStatus"
        },
        "observation": {
          "$ref": "#/$defs/EvaluationObservation"
        }
      },
      "required": [
        "case_id",
        "retrieval",
        "citation",
        "refusal",
        "end_to_end",
        "observation"
      ],
      "title": "CaseEvaluationResult",
      "type": "object"
    },
    "DatasetReview": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "reviewed",
            "fixture"
          ],
          "title": "Status",
          "type": "string"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        }
      },
      "required": [
        "status"
      ],
      "title": "DatasetReview",
      "type": "object"
    },
    "EvaluationObservation": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "answered",
            "refused",
            "error"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Answer"
        },
        "retrieved_evidence": {
          "items": {
            "$ref": "#/$defs/ObservedEvidence"
          },
          "title": "Retrieved Evidence",
          "type": "array"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/ObservedEvidence"
          },
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "outcome",
        "answer",
        "retrieved_evidence",
        "citations"
      ],
      "title": "EvaluationObservation",
      "type": "object"
    },
    "EvaluationRunMetadata": {
      "additionalProperties": false,
      "properties": {
        "code_commit": {
          "minLength": 1,
          "title": "Code Commit",
          "type": "string"
        },
        "model_provider": {
          "minLength": 1,
          "title": "Model Provider",
          "type": "string"
        },
        "model_name": {
          "minLength": 1,
          "title": "Model Name",
          "type": "string"
        },
        "workflow_version": {
          "minLength": 1,
          "title": "Workflow Version",
          "type": "string"
        },
        "parser_version": {
          "minLength": 1,
          "title": "Parser Version",
          "type": "string"
        },
        "tokenizer": {
          "minLength": 1,
          "title": "Tokenizer",
          "type": "string"
        },
        "chunk_size": {
          "exclusiveMinimum": 0,
          "title": "Chunk Size",
          "type": "integer"
        },
        "chunk_overlap": {
          "minimum": 0,
          "title": "Chunk Overlap",
          "type": "integer"
        },
        "chunking_version": {
          "minLength": 1,
          "title": "Chunking Version",
          "type": "string"
        },
        "embedding_provider": {
          "minLength": 1,
          "title": "Embedding Provider",
          "type": "string"
        },
        "embedding_model": {
          "minLength": 1,
          "title": "Embedding Model",
          "type": "string"
        },
        "embedding_revision": {
          "minLength": 1,
          "title": "Embedding Revision",
          "type": "string"
        },
        "embedding_dimension": {
          "exclusiveMinimum": 0,
          "title": "Embedding Dimension",
          "type": "integer"
        },
        "embedding_version": {
          "minLength": 1,
          "title": "Embedding Version",
          "type": "string"
        },
        "retrieval_version": {
          "minLength": 1,
          "title": "Retrieval Version",
          "type": "string"
        },
        "retrieval_top_k": {
          "exclusiveMinimum": 0,
          "title": "Retrieval Top K",
          "type": "integer"
        },
        "retrieval_minimum_score": {
          "maximum": 1,
          "minimum": -1,
          "title": "Retrieval Minimum Score",
          "type": "number"
        },
        "retrieval_minimum_evidence": {
          "exclusiveMinimum": 0,
          "title": "Retrieval Minimum Evidence",
          "type": "integer"
        },
        "generation_prompt_version": {
          "minLength": 1,
          "title": "Generation Prompt Version",
          "type": "string"
        },
        "question_rewrite_prompt_version": {
          "minLength": 1,
          "title": "Question Rewrite Prompt Version",
          "type": "string"
        },
        "evidence_assessment_prompt_version": {
          "minLength": 1,
          "title": "Evidence Assessment Prompt Version",
          "type": "string"
        },
        "citation_repair_prompt_version": {
          "minLength": 1,
          "title": "Citation Repair Prompt Version",
          "type": "string"
        }
      },
      "required": [
        "code_commit",
        "model_provider",
        "model_name",
        "workflow_version",
        "parser_version",
        "tokenizer",
        "chunk_size",
        "chunk_overlap",
        "chunking_version",
        "embedding_provider",
        "embedding_model",
        "embedding_revision",
        "embedding_dimension",
        "embedding_version",
        "retrieval_version",
        "retrieval_top_k",
        "retrieval_minimum_score",
        "retrieval_minimum_evidence",
        "generation_prompt_version",
        "question_rewrite_prompt_version",
        "evidence_assessment_prompt_version",
        "citation_repair_prompt_version"
      ],
      "title": "EvaluationRunMetadata",
      "type": "object"
    },
    "EvaluationStatus": {
      "enum": [
        "passed",
        "failed",
        "pending_review",
        "not_applicable"
      ],
      "type": "string"
    },
    "EvaluationSummary": {
      "additionalProperties": false,
      "properties": {
        "passed": {
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "pending_review": {
          "minimum": 0,
          "title": "Pending Review",
          "type": "integer"
        },
        "not_applicable": {
          "minimum": 0,
          "title": "Not Applicable",
          "type": "integer"
        }
      },
      "required": [
        "passed",
        "failed",
        "pending_review",
        "not_applicable"
      ],
      "title": "EvaluationSummary",
      "type": "object"
    },
    "ObservedEvidence": {
      "additionalProperties": false,
      "properties": {
        "document_version_id": {
          "format": "uuid",
          "title": "Document Version Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "document_version_id",
        "page_number",
        "text"
      ],
      "title": "ObservedEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "title": "Dataset Version",
      "type": "string"
    },
    "knowledge_base_id": {
      "format": "uuid",
      "title": "Knowledge Base Id",
      "type": "string"
    },
    "document_version_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Document Version Ids",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/EvaluationRunMetadata"
    },
    "judgment_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/DatasetReview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/CaseEvaluationResult"
      },
      "title": "Cases",
      "type": "array"
    },
    "retrieval_summary": {
      "$ref": "#/$defs/EvaluationSummary"
    },
    "citation_summary": {
      "$ref": "#/$defs/EvaluationSummary"
    },
    "refusal_summary": {
      "$ref": "#/$defs/EvaluationSummary"
    },
    "end_to_end_summary": {
      "$ref": "#/$defs/EvaluationSummary"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "knowledge_base_id",
    "document_version_ids",
    "metadata",
    "cases",
    "retrieval_summary",
    "citation_summary",
    "refusal_summary",
    "end_to_end_summary"
  ],
  "title": "EvaluationReport",
  "type": "object"
}
