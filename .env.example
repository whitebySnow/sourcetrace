APP_ENV=development
APP_NAME=SourceTrace API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:5173"]
API_REQUEST_ID_HEADER=X-Request-ID
LOG_LEVEL=INFO

POSTGRES_DB=sourcetrace
POSTGRES_USER=sourcetrace
POSTGRES_PASSWORD=sourcetrace_dev
DATABASE_URL=postgresql+asyncpg://sourcetrace:sourcetrace_dev@localhost:5432/sourcetrace
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=500
INGESTION_TOKENIZER=cl100k_base
INGESTION_CHUNK_SIZE=500
INGESTION_CHUNK_OVERLAP=80
INGESTION_CHUNKING_CONFIG_VERSION=token-window-v1

LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=120
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_OPERATION_DEADLINE_SECONDS=361
LLM_ANSWER_OUTPUT_THINKING=disabled
LLM_STRUCTURED_OUTPUT_MODE=json_object
LLM_STRUCTURED_OUTPUT_THINKING=disabled
LLM_STRUCTURED_OUTPUT_MAX_TOKENS=2048
LLM_PROMPT_VERSION=grounded-answer-v6
LLM_RETRIEVAL_PLAN_PROMPT_VERSION=two-stage-evidence-slots-v7
LLM_EVIDENCE_ASSESSMENT_PROMPT_VERSION=evidence-assessment-v7
LLM_CITATION_REPAIR_PROMPT_VERSION=citation-repair-v7
ANSWER_CONTEXT_QUESTION_LIMIT=4
RETRIEVAL_TOP_K=8
RETRIEVAL_PAGE_NEIGHBOR_COUNT=1
RETRIEVAL_RRF_RANK_CONSTANT=60
RETRIEVAL_MINIMUM_SCORE=0.5
RETRIEVAL_MINIMUM_EVIDENCE=1
RETRIEVAL_CONFIG_VERSION=pgvector-hybrid-query-aware-bge-reranker-v9
ANSWER_WORKFLOW_VERSION=langgraph-bounded-multi-query-v8
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_CACHE_DIR=D:\DevelopEnvironment\huggingface
EMBEDDING_HF_ENDPOINT=https://hf-mirror.com
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
EMBEDDING_DIMENSION=1024
EMBEDDING_CONFIG_VERSION=bge-m3-dense-v1
RERANKER_PROVIDER=sentence-transformers
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_REVISION=e099d4b9cdbd291b1569d416f19aaa6523570bc3
RERANKER_MODEL_WEIGHT_SHA256=d9e3e081faff1eefb84019509b2f5558fd74c1a05a2c7db22f74174fcedb5286
RERANKER_CACHE_DIR=D:\DevelopEnvironment\huggingface
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
RERANKER_CONFIG_VERSION=bge-reranker-v2-m3-cross-encoder-v1
HF_CACHE_HOST_PATH=./data/huggingface
EMBEDDING_MODEL_CONTAINER=BAAI/bge-m3

VITE_API_BASE_URL=http://localhost:8000
