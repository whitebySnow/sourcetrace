APP_ENV=development
APP_NAME=SourceTrace API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:5173"]
API_REQUEST_ID_HEADER=X-Request-ID
LOG_LEVEL=INFO

POSTGRES_DB=sourcetrace
POSTGRES_USER=sourcetrace
POSTGRES_PASSWORD=sourcetrace_dev
DATABASE_URL=postgresql+asyncpg://sourcetrace:sourcetrace_dev@localhost:5432/sourcetrace
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=500

LLM_PROVIDER=mock
LLM_MODEL=mock-chat
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedding

VITE_API_BASE_URL=http://localhost:8000
